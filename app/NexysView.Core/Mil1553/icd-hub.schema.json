{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nexys-view/icd-hub/1.0",
  "title": "ICD hub 1.0",
  "description": "Interface control document hub: MIL-STD-1553 messages and their words (bit fields with engineering-unit scaling).",
  "type": "object",
  "required": ["version", "messages"],
  "properties": {
    "version": { "const": 1 },
    "source": { "type": "string" },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "rt", "sa", "tr", "wc"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 64 },
          "rt": { "type": "integer", "minimum": 0, "maximum": 31 },
          "sa": { "type": "integer", "minimum": 0, "maximum": 31 },
          "tr": { "type": "integer", "enum": [0, 1], "description": "0 = BC->RT (receive), 1 = RT->BC (transmit)" },
          "wc": { "type": "integer", "minimum": 1, "maximum": 32 },
          "period_ms": { "type": "number", "minimum": 0 },
          "bus": { "type": "string", "enum": ["A", "B"] },
          "words": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["index", "bit_start", "bit_len", "type", "name"],
              "properties": {
                "index": { "type": "integer", "minimum": 1, "maximum": 32 },
                "bit_start": { "type": "integer", "minimum": 1, "maximum": 16, "description": "LSB = 1" },
                "bit_len": { "type": "integer", "minimum": 1, "maximum": 512 },
                "type": { "type": "string", "enum": ["BNR", "BCD", "Discrete", "SIMSCALAR", "DECSCALAR", "IEEE32", "IEEE64", "BNR48", "BNR64", "MIL1750_32", "MIL1750_48", "MIL1750_64", "CAPS32", "CAPS48", "DEC64", "Custom", "String"] },
                "scale": { "type": "number" },
                "offset": { "type": "number" },
                "unit": { "type": "string" },
                "name": { "type": "string", "minLength": 1, "maxLength": 64 }
              }
            }
          }
        }
      }
    }
  }
}

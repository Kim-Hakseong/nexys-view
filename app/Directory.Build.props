<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Deterministic>true</Deterministic>
    <Version>0.9.2-beta</Version>
    <AssemblyVersion>0.9.2.0</AssemblyVersion>
    <FileVersion>0.9.2.0</FileVersion>
    <InformationalVersion>0.9.2-beta</InformationalVersion>
    <Company>Nexys</Company>
    <Product>Nexys VIEW</Product>
  </PropertyGroup>
  <PropertyGroup>
    <!-- optional .dxd reader: sibling project outside this repository -->
    <DxdAvailable Condition="Exists('$(MSBuildThisFileDirectory)..\..\dxd\app\MiniMeas.Core\MiniMeas.Core.csproj')">true</DxdAvailable>
    <DefineConstants Condition="'$(DxdAvailable)' == 'true'">$(DefineConstants);DXD</DefineConstants>
  </PropertyGroup>
</Project>
